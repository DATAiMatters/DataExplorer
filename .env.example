# Neo4j connection settings
NEO4J_URI=bolt+s://your-neo4j-instance:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# (Optional) Cloudflare Access Service Token
CF_ACCESS_CLIENT_ID=your_client_id.access
CF_ACCESS_CLIENT_SECRET=your_client_secret

# SKP API settings
SKP_API_BASE=https://api.syniti.com
SKP_API_USER=your_skp_api_user
SKP_API_PASSWORD=your_skp_api_password
