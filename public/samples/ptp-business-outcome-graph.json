    "rules": [
      {
        "id": "RULE-PTP-001",
        "name": "Vendor Bank Account Present",
        "description": "Every active vendor must have at least one valid bank account configured",
        "cdeId": "",
        "ruleType": "completeness",
        "expression": "LFBK.BANKN IS NOT NULL AND LFBK.BANKL IS NOT NULL",
        "severity": "critical",
        "passThreshold": 100,
        "isExecutable": true,
        "lastRunResult": {
          "totalRecords": 5420,
          "passedRecords": 5385,
          "failedRecords": 35,
          "passRate": 99.35
        },
        "createdAt": "2026-01-25T00:00:00Z",
        "updatedAt": "2026-01-25T00:00:00Z"
      },
      {
        "id": "RULE-PTP-002",
        "name": "Vendor Bank Country Valid",
        "description": "Vendor bank country must be a valid ISO country code",
        "cdeId": "",
        "ruleType": "validity",
        "expression": "LFBK.BANKS IN (SELECT LAND1 FROM T005)",
        "severity": "major",
        "passThreshold": 100,
        "isExecutable": true,
        "lastRunResult": {
          "totalRecords": 5385,
          "passedRecords": 5380,
          "failedRecords": 5,
          "passRate": 99.91
        },
        "createdAt": "2026-01-25T00:00:00Z",
        "updatedAt": "2026-01-25T00:00:00Z"
      },
      {
        "id": "RULE-PTP-003",
        "name": "Payment Method Consistency",
        "description": "Vendor default payment method must be consistent with configured bank details",
        "cdeId": "",
        "ruleType": "consistency",
        "expression": "LFA1.ZWELS MATCHES LFBK payment capabilities",
        "severity": "major",
        "passThreshold": 98,
        "isExecutable": true,
        "lastRunResult": {
          "totalRecords": 5420,
          "passedRecords": 5350,
          "failedRecords": 70,
          "passRate": 98.71
        },
        "createdAt": "2026-01-25T00:00:00Z",
        "updatedAt": "2026-01-25T00:00:00Z"
      },
      {
        "id": "RULE-PTP-004",
        "name": "Invoice Payment Terms Present",
        "description": "Every posted invoice must have payment terms assigned",
        "cdeId": "",
        "ruleType": "completeness",
        "expression": "BSEG.ZTERM IS NOT NULL",
        "severity": "major",
        "passThreshold": 100,
        "isExecutable": true,
        "lastRunResult": {
          "totalRecords": 12450,
          "passedRecords": 12403,
          "failedRecords": 47,
          "passRate": 99.62
        },
        "createdAt": "2026-01-25T00:00:00Z",
        "updatedAt": "2026-01-25T00:00:00Z"
      },
      {
        "id": "RULE-PTP-005",
        "name": "Invoice Due Date Derivable",
        "description": "Invoice due date must be calculable from baseline date and payment terms",
        "cdeId": "",
        "ruleType": "validity",
        "expression": "BKPF.BLDAT IS NOT NULL AND T052.ZTAG1 IS NOT NULL",
        "severity": "critical",
        "passThreshold": 100,
        "isExecutable": true,
        "lastRunResult": {
          "totalRecords": 12450,
          "passedRecords": 12448,
          "failedRecords": 2,
          "passRate": 99.98
        },
        "createdAt": "2026-01-25T00:00:00Z",
        "updatedAt": "2026-01-25T00:00:00Z"
      },
      {
        "id": "RULE-PTP-006",
        "name": "Payment Block Reason Provided When Blocked",
        "description": "If an invoice has a payment block, a reason code must be provided",
        "cdeId": "",
        "ruleType": "consistency",
        "expression": "IF BSEG.ZLSPR <> '' THEN BSEG.ZLSCH IS NOT NULL",
        "severity": "minor",
        "passThreshold": 95,
        "isExecutable": true,
        "lastRunResult": {
          "totalRecords": 892,
          "passedRecords": 890,
          "failedRecords": 2,
          "passRate": 99.78
        },
        "createdAt": "2026-01-25T00:00:00Z",
        "updatedAt": "2026-01-25T00:00:00Z"
      }
