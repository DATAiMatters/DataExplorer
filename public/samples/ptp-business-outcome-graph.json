        "ownerRole": "AP Manager",
        "system": "SAP",
        "touchpoint": "F110",
        "cadence": "Weekly",
        "criticality": "High",
        "cutoffRule": "Invoices due within 7 days must be eligible for the next payment run",
        "goalIds": ["GOAL-PTP-001", "GOAL-PTP-002"],
