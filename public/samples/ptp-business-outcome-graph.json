  "assets": {
    "goals": [
      {
        "id": "GOAL-PTP-001",
        "name": "On-Time Supplier Payment",
        "description": "Ensure suppliers are paid on or before due date to protect supply continuity and avoid penalties.",
        "category": "operational",
        "owner": "AP Director",
        "targetValue": "≥ 98% on-time supplier payments",
        "status": "active",
        "tags": ["payment", "supplier", "cash-flow"],
        "processAreaIds": ["PROC-PTP"],
        "createdAt": "2026-01-25T00:00:00Z",
        "updatedAt": "2026-01-25T00:00:00Z"
      },
      {
        "id": "GOAL-PTP-002",
        "name": "Minimize Early Payment Discount Loss",
        "description": "Capture available early payment discounts by paying within discount terms window.",
        "category": "financial",
        "owner": "Treasury Manager",
        "targetValue": "≥ 90% discount capture rate",
        "status": "active",
        "tags": ["discount", "cash-optimization"],
        "processAreaIds": ["PROC-PTP"],
        "createdAt": "2026-01-25T00:00:00Z",
        "updatedAt": "2026-01-25T00:00:00Z"
      }
    ],
    "kpis": [
      {
        "id": "KPI-PTP-001",
        "name": "% Supplier Payments On-Time",
        "description": "Percentage of supplier invoices paid on or before the due date",
        "formula": "(Invoices Paid On-Time / Total Invoices Due) × 100",
        "unit": "PERCENT",
        "direction": "higher_is_better",
        "targetValue": 98,
        "warningThreshold": 95,
        "criticalThreshold": 90,
        "frequency": "weekly",
        "owner": "AP Manager",
        "status": "active",
        "outcomeIds": ["GOAL-PTP-001"],
        "cdeIds": [],
        "createdAt": "2026-01-25T00:00:00Z",
        "updatedAt": "2026-01-25T00:00:00Z"
      },
      {
        "id": "KPI-PTP-002",
        "name": "Early Payment Discount Capture Rate",
        "description": "Percentage of available early payment discounts successfully captured",
        "formula": "(Discounts Captured / Discounts Available) × 100",
        "unit": "PERCENT",
        "direction": "higher_is_better",
        "targetValue": 90,
        "warningThreshold": 80,
        "criticalThreshold": 70,
        "frequency": "monthly",
        "owner": "Treasury Analyst",
        "status": "active",
        "outcomeIds": ["GOAL-PTP-002"],
        "cdeIds": [],
        "createdAt": "2026-01-25T00:00:00Z",
        "updatedAt": "2026-01-25T00:00:00Z"
      }
    ],
